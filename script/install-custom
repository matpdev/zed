#!/usr/bin/env bash
# Install the personal Zed (branch `custom`).
#
#   script/install-custom              # download the latest GitHub release of the fork and install it
#   script/install-custom --local      # build locally (official release profile) and install
#   script/install-custom --file X     # install a tarball made by script/package-custom
#   script/install-custom --list       # list installed releases (* = active)
#   script/install-custom --use ID     # switch to another installed release (rollback)
#
# Installed layout:
#   ~/.local/share/zed-custom/releases/<version>-<commit>/{bin/zed, libexec/zed-editor, share/...}
#   ~/.local/share/zed-custom/current -> releases/<the active one>
#   ~/.local/bin/{zed,zeditor} -> current/bin/zed
#   ~/.local/share/applications/dev.zed.Zed.desktop
#
# Settings, extensions and sessions are not touched: they stay in ~/.config/zed and ~/.local/share/zed.
set -euo pipefail
cd "$(dirname "$0")/.."

REPO="${ZED_CUSTOM_REPO:-matpdev/zed}"
ASSET=zed-custom-linux-x86_64.tar.gz
ROOT="${ZED_CUSTOM_ROOT:-$HOME/.local/share/zed-custom}"
KEEP="${KEEP:-3}"
APP_ID=dev.zed.Zed
BIN_DIR="$HOME/.local/bin"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_ID.desktop"

activate() {
    local release=$1
    ln -sfn "releases/$release" "$ROOT/current"
    mkdir -p "$BIN_DIR" "$(dirname "$DESKTOP_FILE")"
    ln -sf "$ROOT/current/bin/zed" "$BIN_DIR/zed"
    ln -sf "$ROOT/current/bin/zed" "$BIN_DIR/zeditor"
    DO_STARTUP_NOTIFY=true \
        APP_ICON="$ROOT/current/share/icons/hicolor/512x512/apps/zed.png" \
        APP_NAME="Zed" \
        APP_CLI="$ROOT/current/bin/zed" \
        APP_ID="$APP_ID" \
        APP_ARGS="%U" \
        envsubst < "$ROOT/current/share/zed.desktop.in" > "$DESKTOP_FILE"
    update-desktop-database "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
    echo "Active release: $release"
}

install_tarball() {
    local tarball=$1 staging release
    staging=$(mktemp -d)
    tar -C "$staging" -xzf "$tarball"
    release=$(<"$staging/zed-custom/RELEASE")
    mkdir -p "$ROOT/releases"
    rm -rf "${ROOT:?}/releases/$release"
    mv "$staging/zed-custom" "$ROOT/releases/$release"
    rm -rf "$staging"
    activate "$release"

    # Keep only the newest $KEEP releases (never the active one).
    ls -1t "$ROOT/releases" | tail -n +"$((KEEP + 1))" | while read -r old; do
        [[ $old == "$release" ]] || { echo "Removing old release $old"; rm -rf "${ROOT:?}/releases/$old"; }
    done
    "$BIN_DIR/zed" --version
}

case ${1:-} in
    --list)
        current=$(readlink "$ROOT/current" 2>/dev/null || true)
        for dir in "$ROOT"/releases/*/; do
            name=$(basename "$dir")
            [[ "releases/$name" == "$current" ]] && marker='*' || marker=' '
            echo "$marker $name  $(cut -c1-60 "$dir/COMMIT" 2>/dev/null | cut -d' ' -f2-)"
        done
        ;;
    --use)
        [[ -d "$ROOT/releases/${2:-}" ]] || { echo "unknown release: ${2:-}" >&2; exit 1; }
        activate "$2"
        ;;
    --file)
        install_tarball "${2:?usage: $0 --file TARBALL}"
        ;;
    --local)
        if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
            echo "warning: uncommitted changes will be included in this build" >&2
        fi
        export PROTOC=/usr/bin/protoc PROTOC_INCLUDE=/usr/include
        export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 ZSTD_SYS_USE_PKG_CONFIG=1
        export RELEASE_VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/zed/Cargo.toml | head -n1)
        export ZED_UPDATE_EXPLANATION="Custom build: update with git in $PWD and run script/install-custom"
        LINK=()
        command -v mold >/dev/null && LINK=(mold -run)
        "${LINK[@]}" cargo build --release -j "${JOBS:-8}" --package zed --package cli
        tarball=$(mktemp --suffix=.tar.gz)
        script/package-custom "$tarball"
        install_tarball "$tarball"
        rm -f "$tarball"
        ;;
    "")
        echo "Fetching the latest release of $REPO..."
        url=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" |
            python3 -I -c 'import json, sys
release = json.load(sys.stdin)
print(next(a["browser_download_url"] for a in release["assets"] if a["name"] == sys.argv[1]))' "$ASSET")
        tarball=$(mktemp --suffix=.tar.gz)
        trap 'rm -f "$tarball"' EXIT
        echo "Downloading $url"
        curl -fL --retry 3 -o "$tarball" "$url"
        install_tarball "$tarball"
        ;;
    *)
        echo "usage: $0 [--local | --file TARBALL | --list | --use RELEASE]" >&2
        exit 2
        ;;
esac
